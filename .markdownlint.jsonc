{
  // Lean конфигурация: фокус на структурных ошибках, не на стиле.
  // Отключаем шумные правила, оставляем те, что ловят реальные проблемы.
  "default": true,
  "MD013": false,          // line length — markdown с длинными строками нормален
  "MD024": { "siblings_only": true }, // одинаковые заголовки в разных секциях ок
  "MD026": false,          // trailing punctuation in heading — нужно для шаблонов с "..."
  "MD032": false,          // blanks around lists — слишком придирчиво
  "MD033": false,          // inline HTML — иногда нужен
  "MD036": false,          // emphasis as heading — для подзаголовков ок
  "MD041": false,          // first line H1 — не всегда applicable (templates)
  "MD060": false           // table column style — компактный стиль таблиц намеренно
}
